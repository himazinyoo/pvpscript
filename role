<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Web ルーレット</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Kaisei+Decol:wght@400;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --red: #f44336;
    --red-dark: #c62828;
    --red-light: #fdecea;
    --bg: #f5f6fa;
    --card: #ffffff;
    --text: #1a1a2e;
    --muted: #7a7a9a;
    --border: rgba(0,0,0,0.08);
  }
  body {
    font-family: 'Noto Sans JP', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  header {
    width: 100%;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 16px 32px;
    box-shadow: 0 2px 8px rgba(80,80,160,0.06);
  }
  header h1 {
    font-family: 'Kaisei Decol', serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
  }
  main {
    flex: 1;
    width: 100%;
    max-width: 700px;
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .wheel-outer {
    position: relative;
    width: 360px;
    height: 360px;
  }
  .pointer {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 0; height: 0;
    border-left: 14px solid transparent;
    border-right: 14px solid transparent;
    border-top: 28px solid var(--red);
    filter: drop-shadow(0 2px 4px rgba(244,67,54,0.5));
    z-index: 10;
  }
  #wheel { border-radius: 50%; display: block; }
  .spin-btn {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 90px; height: 44px;
    border-radius: 22px;
    border: none;
    background: var(--red);
    color: white;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    z-index: 20;
    box-shadow: 0 4px 14px rgba(244,67,54,0.45);
    transition: opacity 0.2s, transform 0.1s;
  }
  .spin-btn:hover:not(:disabled) { opacity: 0.9; }
  .spin-btn:active:not(:disabled) { transform: translate(-50%,-50%) scale(0.95); }
  .spin-btn:disabled { opacity: 0.5; cursor: default; }
  .result-box {
    padding: 16px 32px;
    border-radius: 14px;
    border: 1.5px solid var(--border);
    font-size: 20px;
    font-weight: 700;
    text-align: center;
    color: var(--muted);
    background: #f8f8fc;
    transition: all 0.3s ease;
    font-family: 'Kaisei Decol', serif;
    width: 360px;
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .result-box.hazure {
    background: var(--red-light);
    color: var(--red-dark);
    border-color: #ef9a9a;
    animation: pop 0.4s ease;
  }
  @keyframes pop {
    0%  { transform: scale(0.92); }
    60% { transform: scale(1.05); }
    100%{ transform: scale(1); }
  }
  .btn-reset {
    padding: 12px 36px;
    border-radius: 10px;
    border: 1.5px solid var(--border);
    background: white;
    color: var(--muted);
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-reset:hover { background: #f0f0f8; }
  .btn-reset:disabled { opacity: 0.45; cursor: default; }
  .hint { font-size: 12px; color: var(--muted); letter-spacing: 0.04em; }
  .confetti-wrap {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none; z-index: 100;
  }
  .conf {
    position: absolute;
    width: 8px; height: 8px;
    border-radius: 2px;
    opacity: 0;
    animation: fall 1.6s ease-in forwards;
  }
  @keyframes fall {
    0%  { opacity: 1; transform: translateY(-20px) rotate(0deg); }
    100%{ opacity: 0; transform: translateY(100vh) rotate(600deg); }
  }
  footer {
    width: 100%;
    text-align: center;
    padding: 20px;
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }
</style>
</head>
<body>

<header>
  <h1>🎰 Web ルーレット</h1>
</header>

<main>
  <div class="wheel-outer">
    <div class="pointer"></div>
    <canvas id="wheel" width="360" height="360"></canvas>
    <button class="spin-btn" id="spinBtn">回転</button>
  </div>
  <div class="result-box" id="result">回転を押してください</div>
  <button class="btn-reset" id="resetBtn">リセット</button>
  <p class="hint">※ どれが出ても必ずハズレです</p>
</main>

<div class="confetti-wrap" id="confetti"></div>
<footer>© 2025 Web ルーレット</footer>

<script>
const canvas = document.getElementById('wheel');
const ctx = canvas.getContext('2d');
const resultBox = document.getElementById('result');
const spinBtn = document.getElementById('spinBtn');
const resetBtn = document.getElementById('resetBtn');
const confettiWrap = document.getElementById('confetti');

// 2 slices half/half
const slices = [
  { label: 'あたり', color: '#2e7d32' },
  { label: 'はずれ', color: '#8bc34a' },
];

const POINTER = -Math.PI / 2; // top
let angle = 0;
let spinning = false;

function drawWheel(rot) {
  const n = slices.length;
  const cx = 180, cy = 180, r = 176;
  const slice = (2 * Math.PI) / n;
  ctx.clearRect(0, 0, 360, 360);

  slices.forEach((s, i) => {
    const start = rot + i * slice;
    const end = start + slice;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.arc(cx, cy, r, start, end);
    ctx.closePath();
    ctx.fillStyle = s.color;
    ctx.fill();
    ctx.strokeStyle = 'white';
    ctx.lineWidth = 3;
    ctx.stroke();

    const mid = start + slice / 2;
    const tx = cx + Math.cos(mid) * r * 0.55;
    const ty = cy + Math.sin(mid) * r * 0.55;
    ctx.save();
    ctx.translate(tx, ty);
    ctx.rotate(mid + Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = 'white';
    ctx.font = 'bold 30px "Noto Sans JP", sans-serif';
    ctx.shadowColor = 'rgba(0,0,0,0.3)';
    ctx.shadowBlur = 4;
    ctx.fillText(s.label, 0, 0);
    ctx.restore();
  });

  ctx.beginPath();
  ctx.arc(cx, cy, r, 0, 2 * Math.PI);
  ctx.strokeStyle = 'rgba(0,0,0,0.15)';
  ctx.lineWidth = 4;
  ctx.stroke();

  ctx.beginPath();
  ctx.arc(cx, cy, 48, 0, 2 * Math.PI);
  ctx.fillStyle = 'rgba(0,0,0,0.1)';
  ctx.fill();
}

drawWheel(angle);

function getIndexAtPointer(a) {
  const slice = (2 * Math.PI) / slices.length;
  let rel = ((POINTER - a) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);
  return Math.floor(rel / slice) % slices.length;
}

function spawnConfetti() {
  confettiWrap.innerHTML = '';
  const colors = ['#f44336','#8bc34a','#ffb74d','#64b5f6','#ba68c8','#f06292'];
  for (let i = 0; i < 60; i++) {
    const el = document.createElement('div');
    el.className = 'conf';
    el.style.left = Math.random() * 100 + 'vw';
    el.style.top = '-10px';
    el.style.background = colors[Math.floor(Math.random() * colors.length)];
    el.style.animationDelay = (Math.random() * 0.8) + 's';
    el.style.animationDuration = (1.2 + Math.random() * 0.8) + 's';
    el.style.width = (6 + Math.random() * 8) + 'px';
    el.style.height = (6 + Math.random() * 8) + 'px';
    confettiWrap.appendChild(el);
  }
  setTimeout(() => confettiWrap.innerHTML = '', 3000);
}

function spin() {
  if (spinning) return;
  spinning = true;
  spinBtn.disabled = true;
  resetBtn.disabled = true;
  resultBox.className = 'result-box';
  resultBox.textContent = '回転中...';

  const slice = (2 * Math.PI) / slices.length;
  // Always land on hazure (index 1)
  const targetIdx = 1;
  const offset = 0.2 + Math.random() * 0.6;
  const targetAngle = POINTER - (targetIdx * slice + slice * offset);
  const norm = ((targetAngle % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);
  const rounds = (6 + Math.floor(Math.random() * 4)) * 2 * Math.PI;
  const curNorm = ((angle % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);
  let delta = (norm - curNorm + 2 * Math.PI) % (2 * Math.PI);
  if (delta < 0.15) delta += 2 * Math.PI;
  const endAngle = angle + rounds + delta;

  const duration = 4000 + Math.random() * 1000;
  const startA = angle;
  const startTime = performance.now();

  function ease(t) { return 1 - Math.pow(1 - t, 3.8); }

  function frame(now) {
    const t = Math.min((now - startTime) / duration, 1);
    angle = startA + (endAngle - startA) * ease(t);
    drawWheel(angle);
    if (t < 1) {
      requestAnimationFrame(frame);
    } else {
      angle = angle % (2 * Math.PI);
      resultBox.className = 'result-box hazure';
      resultBox.textContent = '「はずれ」😢 残念でした！';
      spawnConfetti();
      spinning = false;
      spinBtn.disabled = false;
      resetBtn.disabled = false;
    }
  }
  requestAnimationFrame(frame);
}

function reset() {
  if (spinning) return;
  angle = 0;
  drawWheel(angle);
  resultBox.className = 'result-box';
  resultBox.textContent = '回転を押してください';
}

spinBtn.addEventListener('click', spin);
resetBtn.addEventListener('click', reset);
</script>
</body>
</html>
